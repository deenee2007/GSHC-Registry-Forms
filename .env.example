# Copy to .env for local development. On Render, set these in the
# service's Environment tab instead. Never commit real values.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). It MUST name
# this app's own database after the host (here GSHC_DB); production will not
# start without one, so the app never shares another application's data.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/GSHC_DB?retryWrites=true&w=majority

# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Cloudinary (Dashboard > API Keys > API environment variable)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=gshc-registry

# First admin account (used only when the database has no users)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Recovery: set to true and restart to reset the admin password to
# ADMIN_PASSWORD and unlock the account. Runs once per ADMIN_PASSWORD value.
# Remove it again after signing in.
ADMIN_RESET=

# Email through Brevo (Brevo > SMTP & API > API Keys; the key starts with
# "xkeysib-", not the SMTP key). MAIL_FROM must be a sender verified in
# Brevo (Senders, Domains & Dedicated IPs). Without these, invitations and
# "Forgot password" are switched off and admins hand out one time passwords.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=GSHC Registry

# Optional: pin QR verification links to one domain. Leave empty to use
# the address the app is opened from.
PUBLIC_BASE_URL=

# Optional: minutes of inactivity before a user is signed out (default 60)
SESSION_IDLE_MINUTES=60

NODE_ENV=development
PORT=3100
